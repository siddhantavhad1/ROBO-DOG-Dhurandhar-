                    ┌───────────┴───────────┐
                    │                       │
               POWER SYSTEM            COMMUNICATION
                    │                       │
          ┌─────────┴─────────┐       ┌─────┴─────┐
          │                   │       │           │
     Logic Power          Servo Power LoRa / Wi-Fi / RF
          │                   │
          │              Servo Motors
          │
    ┌─────┴───────────────────────────────┐
    │          MAIN COMPUTING             │
    │                                     │
    │           Raspberry Pi              │
    │                                     │
    └───────────────┬─────────────────────┘
                    │
          High-Level Processing
                    │
       ┌────────────┼────────────┐
       │            │            │
      SLAM       Vision      Data Processing
       │            │            │
     LiDAR       Camera      Environment
                              Monitoring
                    │
                    ▼
              ┌───────────┐
              │   ESP32   │
              │           │
              │ Real-Time │
              │  Control  │
              └─────┬─────┘
                    │
        ┌───────────┼───────────┐
